# Learnix RAG Environment Variables Configuration Template
# Copy this file to .env and fill in your keys.

# Gemini API Key (for LLM agentic router, synthesis & mitigations)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Cloud PostgreSQL Configuration
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Gmail SMTP Configuration (for sending OTP emails)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_APP_PASSWORD=your_gmail_app_password
